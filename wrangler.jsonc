{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "eudr-proofpack",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-07-05",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "APP_ENV": "production",
    "APP_URL": "https://eudr-proofpack.torahmike.workers.dev",
    "SESSION_TTL_SECONDS": "604800"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "eudr-proofpack-db",
      "database_id": "7005749b-618b-40fd-b2b5-865491ed7fa4",
      "migrations_dir": "./migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PROOF_PACK_FILES",
      "bucket_name": "eudr-proofpack-files"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "ZIP_EXPORT_QUEUE",
        "queue": "eudr-proofpack-zip-exports"
      }
    ],
    "consumers": [
      {
        "queue": "eudr-proofpack-zip-exports",
        "max_batch_size": 10,
        "max_batch_timeout": 30
      }
    ]
  }
}

