{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "eudr-proofpack-staging",
  "main": "dist/eudr_proofpack/index.js",
  "no_bundle": true,
  "compatibility_date": "2026-07-05",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "APP_ENV": "staging",
    "APP_URL": "https://eudr-proofpack-staging.torahmike.workers.dev",
    "SESSION_TTL_SECONDS": "604800",
    "REQUIRE_VERIFIED_EMAIL": "false"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "eudr-proofpack-staging-db",
      "database_id": "89cf7f72-2471-4d5b-b84c-5cd9822ed212",
      "migrations_dir": "./migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PROOF_PACK_FILES",
      "bucket_name": "eudr-proofpack-staging-files"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "ZIP_EXPORT_QUEUE",
        "queue": "eudr-proofpack-staging-zip-exports"
      }
    ],
    "consumers": [
      {
        "queue": "eudr-proofpack-staging-zip-exports",
        "max_batch_size": 10,
        "max_batch_timeout": 30
      }
    ]
  }
}
